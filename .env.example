# All VITE_* values are compiled into the public bundle. Never put a secret here.

# Deployment base path. "/" for a custom domain or a <user>.github.io repo.
# "/<repo-name>/" for a project page, e.g. "/moristack/".
VITE_BASE_PATH=/

# Absolute site origin, used for canonical URLs and social share metadata.
VITE_SITE_URL=https://app-moristack.github.io

# Contact form. Web3Forms is free (250 submissions/month, no card required).
# Get a key by entering your email at https://web3forms.com - it is emailed to you.
# Setting this alone is enough; the endpoint defaults to Web3Forms.
# Without it the form shows an email fallback instead of pretending to send.
VITE_CONTACT_FORM_ACCESS_KEY=

# Only needed to use a different provider (Formspree, FormSubmit, self-hosted).
# VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit

# Optional. Digits only, e.g. 2305xxxxxxx. Enables the WhatsApp links.
VITE_WHATSAPP_NUMBER=

# Optional. Public phone number in international format.
VITE_PHONE=
